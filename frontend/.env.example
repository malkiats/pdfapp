# Frontend environment variables. All NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time: never put secrets here.

# Canonical origin of the website (metadataBase, canonical URLs, sitemap, robots).
# Production: the real https origin, set in Vercel project settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the document API. Browser uploads/downloads go here directly and
# it is added to the CSP connect-src. Local compose API: http://localhost:8000.
# Prism mock (docs/api.md §8): http://localhost:4010
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
