# Local settings for compose.yaml. `make setup` copies this file to .env and
# replaces every __GENERATE__ with a fresh random value. Never commit .env.

# ---- Backend (APP_* settings, see backend/README.md) ----
APP_ENV=local
APP_LOGGING__LEVEL=INFO
APP_LOGGING__JSON_OUTPUT=true
APP_SECURITY__IP_HASH_KEY=__GENERATE__
APP_CORS__ALLOWED_ORIGINS=http://localhost:3000

# ---- Ports published on 127.0.0.1 ----
API_PORT=8000
FRONTEND_PORT=3000
MOCK_PORT=4010

# ---- Frontend (public values, shipped to the browser: no secrets) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Postgres (only with `--profile db`; the app does not use it until Phase 4) ----
POSTGRES_DB=doctools
POSTGRES_USER=doctools
POSTGRES_PASSWORD=__GENERATE__
